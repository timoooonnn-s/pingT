# --- what pingT writes: by default into logs/ (only its README is in git);
#     with --log elsewhere the names follow --log
logs/*
!logs/README.md
*.log
*-summary-*.txt
*-baseline.json
*.tmp
*.bak
*.partial

# --- your own lists: real IPs and names don't belong in git (the *.example.txt files do)
hosts.txt
subnets.txt
inventory.txt
!hosts.example.txt
!subnets.example.txt
!requirements.txt

# --- Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- editors / OS
.idea/
.vscode/
.DS_Store


# --- cache stuff
*cache