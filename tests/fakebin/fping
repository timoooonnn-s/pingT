#!/usr/bin/env python3
"""Fake fping for the tests: answers like 'fping -C1 -q', per IP from the JSON file $FAKE_STATE:
  {"10.9.0.2": "down", "10.9.0.3": "slow", "_default": "down", "_exit": 4, "_fail_chunk_with": ["10.8.0.70"]}
Every IP not listed answers ("up"), unless "_default" says otherwise. $FAKE_SLEEP: seconds per call."""
import json
import os
import sys
import time

try:
    with open(os.environ.get("FAKE_STATE", "")) as fh:
        st = json.load(fh)
except (OSError, ValueError):
    st = {}
targets = [a for a in sys.argv[1:] if not a.startswith("-")]
if st.get("_exit"):
    print("fping: fake failure", file=sys.stderr)
    sys.exit(st["_exit"])
if set(st.get("_fail_chunk_with", [])) & set(targets):
    print("fping: fake chunk failure", file=sys.stderr)
    sys.exit(4)
time.sleep(float(os.environ.get("FAKE_SLEEP", "0.05")))
rc = 0
for t in targets:
    state = st.get(t, st.get("_default", "up"))
    if state == "down":
        rc = 1
        print(f"{t} : -", file=sys.stderr)
    else:
        print(f"{t} : {'45.10' if state == 'slow' else '0.50'}", file=sys.stderr)
sys.exit(rc)
