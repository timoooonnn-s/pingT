#!/usr/bin/env python3
"""Timmy Pinger launcher:  ./pingT -f hosts.txt   (pingT --help for all options)

Runs pingt.py with the project's .venv Python if there is one, so nobody has to
type .venv/bin/python. The code itself lives in pingt.py.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from venvboot import use_project_venv  # noqa: E402

use_project_venv(__file__)

from pingt import main  # noqa: E402

main()
